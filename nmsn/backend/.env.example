# NMSN Configuration Example
# Copy this file to .env and fill in your actual values

# ===================
# Server Configuration
# ===================
PORT=3001
NODE_ENV=development

# ===================
# Database Configuration
# ===================
# For development (in-memory storage)
# MONGODB_URI not required for development

# For production (uncomment and configure)
# MONGODB_URI=mongodb://localhost:27017/nmsn
# MONGODB_USER=your_mongodb_user
# MONGODB_PASSWORD=your_mongodb_password

# ===================
# Metal Exchange APIs
# ===================
# LBMA (London Bullion Market Association)
LBMA_API_KEY=your_lbma_api_key_here
LBMA_API_URL=https://api.lbma.org.uk

# MCX (Multi Commodity Exchange)
MCX_API_KEY=your_mcx_api_key_here
MCX_API_URL=https://api.mcxindia.com

# COMEX (Commodity Exchange)
COMEX_API_KEY=your_comex_api_key_here
COMEX_API_URL=https://api.comex.com

# ===================
# Vault Provider APIs
# ===================
# MMTC-PAMP
MMTC_PAMP_API_KEY=your_mmtc_pamp_api_key_here
MMTC_PAMP_API_URL=https://api.mmtc-pamp.com

# Augmont
AUGMONT_API_KEY=your_augmont_api_key_here
AUGMONT_API_URL=https://api.augmont.com

# SafeGold
SAFEGOLD_API_KEY=your_safegold_api_key_here
SAFEGOLD_API_URL=https://api.safegold.com

# ===================
# BINR Stablecoin Integration
# ===================
BINR_RPC_URL=https://api.binr.co.in
BINR_API_KEY=your_binr_api_key_here
BINR_CONTRACT_ADDRESS=0x...

# ===================
# Blockchain Configuration
# ===================
# INDI Chain
INDI_CHAIN_RPC_URL=https://rpc.indi-chain.com
INDI_CHAIN_API_KEY=your_indi_chain_key

# Hyperledger Fabric
FABRIC_CONFIG_PATH=./fabric-config
FABRIC_CONNECTION_PROFILE=./connection.json

# ===================
# Regulatory Compliance
# ===================
# RBI (Reserve Bank of India)
RBI_API_KEY=your_rbi_api_key_here
RBI_REPORTING_URL=https://api.rbi.org.in

# SEBI (Securities and Exchange Board of India)
SEBI_API_KEY=your_sebi_api_key_here
SEBI_REPORTING_URL=https://api.sebi.org.in

# FIU (Financial Intelligence Unit)
FIU_API_KEY=your_fiu_api_key_here
FIU_REPORTING_URL=https://api.fiu.org.in

# ===================
# Authentication & Security
# ===================
JWT_SECRET=your_super_secure_jwt_secret_here
JWT_EXPIRES_IN=24h

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key

# ===================
# Email & SMS Configuration
# ===================
# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# SMS Service (for OTP)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=NMSN

# ===================
# Payment Gateway Integration
# ===================
# For INR settlement
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===================
# Analytics & Monitoring
# ===================
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# ===================
# Third-party Integrations
# ===================
# KYC Services
KYC_API_KEY=your_kyc_api_key
KYC_API_URL=https://api.kyc-provider.com

# Anti-Money Laundering
AML_API_KEY=your_aml_api_key
AML_API_URL=https://api.aml-service.com

# ===================
# Feature Flags
# ===================
# Enable/disable features
FEATURE_METAL_PAYMENTS=true
FEATURE_MULTI_METAL=true
FEATURE_INSTANT_SETTLEMENT=true
FEATURE_WHITE_LABEL=false
FEATURE_COMPLIANCE_REPORTING=true

# ===================
# Rate Limiting
# ===================
# API rate limits (requests per minute)
API_RATE_LIMIT=100
PAYMENT_RATE_LIMIT=10
PRICING_RATE_LIMIT=60

# ===================
# Development & Testing
# ===================
# Mock services for development
MOCK_EXCHANGE_DATA=true
MOCK_VAULT_DATA=true
MOCK_BINR_DATA=true

# Test mode (disables real transactions)
TEST_MODE=true

# ===================
# CORS Configuration
# ===================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===================
# File Upload Configuration
# ===================
# Max file size for uploads (in bytes)
MAX_FILE_SIZE=5242880

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===================
# Notification Configuration
# ===================
# Webhook URLs for different events
WEBHOOK_PAYMENT_SUCCESS=https://your-app.com/webhooks/payment-success
WEBHOOK_SETTLEMENT_COMPLETE=https://your-app.com/webhooks/settlement
WEBHOOK_ERROR_ALERT=https://your-app.com/webhooks/error

# ===================
# Redis Configuration (for caching)
# ===================
# Redis URL for session storage and caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ===================
# CDN Configuration
# ===================
# For serving static assets
CDN_URL=https://cdn.nmsn.co.in
CDN_API_KEY=your_cdn_api_key

# ===================
# Backup Configuration
# ===================
# Automated backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# S3 or cloud storage for backups
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=nmsn-backups